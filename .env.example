# Enviro+ Air HAT Sensor Logger Configuration
# Copy this file to .env and fill in your values
# Do NOT commit the .env file to version control

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MySQL/MariaDB connection settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=sensor_user
DB_PASSWORD=your_secure_password
DB_NAME=sensor_data

# ===========================================
# SENSOR CONFIGURATION
# ===========================================
# Time between sensor readings (in seconds)
READING_INTERVAL=10

# Number of readings to batch before inserting into database
BATCH_SIZE=5

# ===========================================
# CONNECTION POOLING CONFIGURATION
# ===========================================
# Size of the MySQL connection pool
CONNECTION_POOL_SIZE=5

# Name for the connection pool
CONNECTION_POOL_NAME=sensor_pool

# ===========================================
# ASYNC CONFIGURATION
# ===========================================
# Enable async mode (experimental)
# Requires Python 3.7+
USE_ASYNC=true

# ===========================================
# PROMETHEUS METRICS CONFIGURATION
# ===========================================
# Enable Prometheus metrics endpoint
ENABLE_PROMETHEUS=false

# Port for Prometheus metrics server
PROMETHEUS_PORT=8000

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=critical

# Maximum log file size in bytes (default: 5MB)
LOG_MAX_BYTES=5242880

# Number of backup log files to keep
LOG_BACKUP_COUNT=10

# ===========================================
# SENSOR TIMEOUTS (Advanced)
# ===========================================
# Timeout for PMS5003 sensor reads (in seconds)
PMS_TIMEOUT_SECONDS=5

# Number of retry attempts for sensor initialization
SENSOR_RETRY_ATTEMPTS=3

# Delay between retry attempts (in seconds)
RETRY_DELAY_SECONDS=10

# Number of retry attempts for database connection
DB_RETRY_ATTEMPTS=5

# Delay between database retry attempts (in seconds)
DB_RETRY_DELAY=5
